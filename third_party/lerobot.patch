     # over laggy SSH/VNC links. Case-insensitive so Shift+letter still works.
+    last = {"t": 0.0}
+
     def on_key(name: str) -> None:
+        import time as _time
         key = name.lower()
-        if key in ("right", "n"):
+        if key in ("right", "n", "b", "B"):  # b/B added for this project: end the episode (or the reset) now
